{
  "mcpServers": {
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": [],
      "tools": [
        "*"
      ]
    },
    "context-mode": {
      "type": "stdio",
      "command": "context-mode",
      "args": [],
      "tools": [
        "*"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--stdio"
      ],
      "tools": [
        "*"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "github-mcp-server",
      "args": [
        "stdio"
      ],
      "tools": [
        "*"
      ]
    },
    "graphify": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "graphify.serve",
        "${workspaceFolder}/graphify-out/graph.json"
      ],
      "tools": [
        "*"
      ]
    },
    "markitdown": {
      "type": "stdio",
      "command": "markitdown-mcp",
      "args": [],
      "tools": [
        "*"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ],
      "tools": [
        "*"
      ]
    },
    "semgrep": {
      "type": "stdio",
      "command": "semgrep",
      "args": [
        "mcp"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
