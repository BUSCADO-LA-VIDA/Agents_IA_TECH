{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/beam-free",
  "default_agent": "build",
  "instructions": [
    "AGENTS.md"
  ],
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "python *": "allow",
      "pip install *": "allow",
      "pip uninstall *": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "cd *": "allow",
      "git *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pyright-langserver *": "allow"
    }
  },
  "mcp": {
    "timeout": {
      "startup": 180000,
      "catalog": 120000,
      "execution": 900000
    },
    "servers": {
      "context-mode": {
        "type": "local",
        "command": [
          "C:/Program Files/nodejs/node.exe",
          "C:/Users/tomas/AppData/Roaming/npm/node_modules/context-mode/build/cli.js"
        ]
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": [
          "C:/Users/tomas/.local/bin/codebase-memory-mcp.exe"
        ]
      },
      "markitdown": {
        "type": "local",
        "command": [
          "C:/Python314/Scripts/markitdown-mcp.exe"
        ]
      },
      "graphify": {
        "type": "local",
        "command": [
          "C:/Python314/python.exe",
          "-m",
          "graphify.serve",
          "C:/Proyectos/Agents_IA_TECH/graphify-out/graph.json"
        ]
      },
      "github": {
        "type": "local",
        "command": [
          "C:/Users/tomas/.local/bin/github-mcp-server.exe",
          "stdio"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "C:/Program Files/nodejs/node.exe",
          "C:/Users/tomas/AppData/Roaming/npm/node_modules/@playwright/mcp/cli.js"
        ]
      },
      "tokenslayer": {
        "type": "local",
        "command": [
          "C:/Program Files/nodejs/node.exe",
          "C:/Proyectos/Agents_IA_TECH/proyect_ext/tokenslayer/mcp-server/build/index.js"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "C:/Program Files/nodejs/node.exe",
          "C:/Users/tomas/AppData/Roaming/npm/node_modules/@upstash/context7-mcp/dist/index.js"
        ]
      }
    }
  }
}
