{
  "$schema": "https://opencode.ai/config.json",
  "_note": "Plantilla generica RF-S6: los __TOKENS__ se re-resuelven a rutas locales al ejecutar scripts/plataformador-bootstrap.ps1 (entradas con token arrancan degradadas con enabled=false + WARN). No commitear rutas absolutas.",
  "model": "groq-custom/llama-3.3-70b-versatile",
  "small_model": "groq-custom/llama-3.1-8b-instant",
  "default_agent": "build",
  "plugin": [
    "context-mode"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "nvidia-custom": {
      "name": "NVIDIA",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:NVIDIA_API_KEY}",
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 128000,
            "output": 32000
          }
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      }
    },
    "deepinfra-custom": {
      "name": "DeepInfra",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:DEEPINFRA_API_KEY}",
        "baseURL": "https://api.deepinfra.com/v1/openai"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      }
    }
  },
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": [
        "__CONTEXT_MODE_CMD__"
      ],
      "enabled": false
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "__CODEBASE_MEMORY_CMD__"
      ],
      "enabled": false
    },
    "markitdown": {
      "type": "local",
      "command": [
        "__MARKITDOWN_CMD__"
      ],
      "enabled": false
    },
    "tokenslayer": {
      "type": "local",
      "command": [
        "node",
        "proyect_ext/tokenslayer/mcp-server/build/index.js"
      ],
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "python *": "allow",
      "python -m *": "allow",
      "pip install *": "allow",
      "pip uninstall *": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "cd *": "allow",
      "git *": "allow"
    }
  }
}