{
  "$schema": "https://opencode.ai/config.json",  
  "model": "deepseek-ai/DeepSeek-V4-Flash-0731",
  "small_model": "deepseek-ai/DeepSeek-V4-Flash-0731",
  "default_agent": "build",
  "instructions": ["AGENTS.md"],
  "provider": {
    "nvidia": {
      "name": "NVIDIA",
      "api": "openai",
      "options": {
        "apiKey": "{env:NVIDIA_API_KEY}",
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "z-ai/glm-5.2": {
          "name": "GLM 5.2 (z-ai)",
          "tool_call": true,
          "attachment": true,
          "temperature": true,
          "limit": { "context": 128000, "output": 32000 }
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (NVIDIA)",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      }
    },
    "deepinfra": {
      "name": "DeepInfra",
      "api": "openai",
      "options": {
        "apiKey": "{env:chat.lm.secret.53001bd5}",
        "baseURL": "https://deepinfra.com"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "tool_call": true,
          "attachment": true,
          "temperature": true,
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      }
    }
  },
  "enabled_providers": [
    "nvidia",
    "deepinfra"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "python *": "allow",
      "python -m *": "allow",
      "pip install *": "allow",
      "pip uninstall *": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "cd *": "allow",
      "git *": "allow"
    }
  }
}