{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "pensador",
    "instructions": [
        "AGENTS.md"
    ],
    "permission": {
        "edit": "allow",
        "bash": {
            "*": "allow",
            "python *": "allow",
            "pip install *": "allow",
            "pip uninstall *": "allow",
            "pytest *": "allow",
            "pytest": "allow",
            "cd *": "allow",
            "git *": "allow",
            "node *": "allow",
            "npm *": "allow",
            "npx *": "allow",
            "pyright-langserver *": "allow"
        }
    },
    "mcp": {
        "timeout": {
            "startup": 180000,
            "catalog": 120000,
            "execution": 900000
        },
        "servers": {
            "context-mode": {
                "type": "local",
                "command": [
                    "{env:CONTEXT_MODE_CMD}"
                ],
                "enabled": false
            },
            "codebase-memory-mcp": {
                "type": "local",
                "command": [
                    "{env:CODEBASE_MEMORY_CMD}"
                ],
                "enabled": false
            },
            "markitdown": {
                "type": "local",
                "command": [
                    "{env:MARKITDOWN_CMD}"
                ],
                "enabled": false
            },
            "graphify": {
                "type": "local",
                "command": [
                    "{env:GRAPHIFY_CMD}"
                ],
                "enabled": false
            },
            "github": {
                "type": "local",
                "command": [
                    "{env:GITHUB_MCP_CMD}",
                    "stdio"
                ],
                "enabled": false
            },
            "playwright": {
                "type": "local",
                "command": [
                    "{env:PLAYWRIGHT_MCP_CMD}"
                ],
                "enabled": false
            },
            "tokenslayer": {
                "type": "local",
                "command": [
                    "{env:TOKENSLAYER_CMD}"
                ],
                "enabled": false
            },
            "context7": {
                "type": "local",
                "command": [
                    "{env:CONTEXT7_CMD}"
                ],
                "enabled": false
            },
            "semgrep": {
                "type": "local",
                "command": [
                    "{env:SEMGREP_MCP_CMD}"
                ],
                "enabled": false
            }
        }
    }
}
